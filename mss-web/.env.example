# Public build-time configuration only. Never put secrets in VITE_* variables.
# Empty uses same-origin /api and /uploads (Vite proxy in development).
# An explicit backend origin, with or without a trailing /api, is supported.
VITE_API_URL=

# Public HTTPS canonical origin (no path); match API PUBLIC_SITE_ORIGIN.
# Enable only after public detail URLs serve the API-rendered OpenGraph HTML.
VITE_PUBLIC_SITE_ORIGIN=
