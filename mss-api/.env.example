# Supply a private PostgreSQL URL. Never commit real credentials.
DATABASE_URL=
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5174
NODE_ENV=development
# Optional server-side discovery connection (node-redis defaults to local Redis).
REDIS_URL=
# Optional PUBLIC media HTTP(S) base; this is not the RTMP ingest endpoint.
MEDIA_BASE_URL=
STREAM_DISCOVERY_TIMEOUT_MS=2000

# Optional official SoundCloud public metadata API (server-only secrets).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Optional externally managed access token; overrides the client grant.
SOUNDCLOUD_ACCESS_TOKEN=
# Mixcloud public metadata requires no token. See MEDIA_LIBRARY.md.
# Official YouTube Data API v3, server-only; explicit artist video links only.
# Missing key disables add/refresh with an honest setup state. See YOUTUBE_LINKS.md.
YOUTUBE_API_KEY=

# Private registration mail encryption: base64 of 32 random bytes; keep outside git.
EMAIL_SETTINGS_ENCRYPTION_KEY=
# Set only after confirming Resend domain verification and API-key domain scope.
EMAIL_VERIFIED_SENDER_DOMAIN=

# Public canonical origin for server-rendered artist/event sharing HTML.
# Match VITE_PUBLIC_SITE_ORIGIN and configure public exact-detail proxy routing.
PUBLIC_SITE_ORIGIN=
